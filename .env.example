# Copia questo file in .env (nella cartella di manage.py) e compila i valori.
# Il file .env è escluso da git: non contiene mai credenziali pubblicate.
# Le variabili già esportate nel terminale hanno la precedenza su quelle del file.

# --- Invio email reale (SMTP) ---------------------------------------------
# Senza queste righe le email NON partono: vengono solo stampate nel terminale
# di runserver e segnate come "Simulata" nello storico email.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Esempio Gmail: serve una "password per le app" (non la password dell'account),
# da creare su https://myaccount.google.com/apppasswords con la verifica in due passaggi attiva.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=tuoindirizzo@gmail.com
EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx
# Con Gmail il mittente deve essere lo stesso account (o un alias verificato).
DEFAULT_FROM_EMAIL="DonoFlow <tuoindirizzo@gmail.com>"

# Per un SMTP con SSL diretto (porta 465) usa invece:
# EMAIL_PORT=465
# EMAIL_USE_TLS=0
# EMAIL_USE_SSL=1

# Indirizzo del sito usato nei link delle email.
DONOFLOW_SITE_URL=http://127.0.0.1:8000

# --- Produzione -----------------------------------------------------------
# DJANGO_DEBUG=0
# DJANGO_SECRET_KEY=una-chiave-lunga-e-casuale
# DJANGO_ALLOWED_HOSTS=donoflow.tuodominio.it
